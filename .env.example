# ==============================================================================
# BHARATHI FOUNDATION – PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================

# 1. Base Public Site URL (Required for Sitemap, Canonical URLs & OpenGraph)
# Replace with your deployed custom domain (e.g., https://bharathifoundation.org or Vercel URL)
NEXT_PUBLIC_SITE_URL=https://bharathifoundation.org

# 2. Supabase Cloud PostgreSQL Database & Real-Time Sync (Optional)
# If provided, the app will synchronise data directly to Supabase cloud tables.
# If omitted, the app operates reliably using the local high-fidelity fallback layer.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Security Warning:
# NEVER place SUPABASE_SERVICE_ROLE_KEY or private credentials in this file or commit them to source control.
